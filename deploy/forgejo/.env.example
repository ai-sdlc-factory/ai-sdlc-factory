# Copy to .env alongside compose.yaml. Everything has a default.
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# The factory's Compose project name, if you changed it from ai-sdlc-factory (this project joins its networks).
# FACTORY_PROJECT=ai-sdlc-factory

# This project's own Compose project name: it names the containers and volumes (ai-sdlc-factory-forgejo_mailpit-data, ...). Leave it alone. A Forgejo
# created before the project was renamed from dev-foundry keeps its containers and data by setting COMPOSE_PROJECT_NAME=dev-foundry-forgejo (and
# FACTORY_PROJECT=dev-foundry if the factory itself still has its old name); a different name creates new, empty volumes.
# COMPOSE_PROJECT_NAME=ai-sdlc-factory-forgejo

# Only with compose.shared-postgres.yaml: the password of the "forgejo" role in the factory's PostgreSQL.
# FORGEJO_DB_PASSWORD=
