{
  "image": "dotnet",
  "mode": "full",
  "record": true,
  "reviewers": ["reviewer", "security"],
  "limits": { "build_rounds": 3, "clarification_rounds": 3, "revisions_per_pull_request": 3 },
  "protected_paths": ["**/Migrations/**", "global.json"],
  "rules": [
    { "id": "no-binaryformatter", "files": "**/*.cs", "forbid": "BinaryFormatter", "message": "Unsafe deserialisation. Use System.Text.Json." },
    { "id": "no-env-vars", "files": "src/**/*.cs", "forbid": "Environment\\.GetEnvironmentVariable", "message": "Read configuration through IConfiguration or IOptions<T>." },
    { "id": "no-console", "files": "src/**/*.cs", "forbid": "Console\\.Write", "message": "Use ILogger.", "severity": "warn" }
  ],
  "gates": [
    { "name": "build", "command": ["dotnet", "build", "--nologo", "-v", "q"], "timeout_seconds": 600 },
    { "name": "test", "command": ["dotnet", "test", "--nologo", "-v", "q"], "timeout_seconds": 900 },
    { "name": "audit", "command": ["dotnet", "list", "package", "--vulnerable", "--include-transitive"], "timeout_seconds": 300 }
  ],
  "verify": {
    "start": ["dotnet", "run", "--project", "src/Greetings.Api", "--urls", "http://127.0.0.1:5080"],
    "ready": "http://127.0.0.1:5080/api/greetings/Ada",
    "startup_timeout_seconds": 90,
    "tests": "e2e",
    "suites": [
      { "name": "api", "command": ["dotnet", "test", "e2e/Api.E2E", "--nologo", "-v", "q"], "timeout_seconds": 600 }
    ]
  }
}
