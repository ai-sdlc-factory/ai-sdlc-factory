# Copy to .env alongside compose.yaml; set distinct passwords and a webhook secret.
# Generate each password with: openssl rand -hex 24
POSTGRES_PASSWORD=
FORGEJO_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_DEFAULT_EMAIL=admin@example.com

# Shared with the Forgejo webhook configuration (at least 32 characters).
# Generate with: openssl rand -hex 32
FORGEJO_WEBHOOK_SECRET=

# Access token of the factory's Forgejo bot account (see docs/getting-started.md, step 4). Only the controller
# receives it. Scopes needed: write:issue, write:repository (comments, branches, pull requests). Leave empty to disable.
FORGEJO_BOT_TOKEN=
# The bot account's username. The factory only revises pull requests this account opened (see docs/workflows.md).
# FORGEJO_BOT_LOGIN=factory-bot

# Defaults for projects whose .factory/project.json has no "limits" (a project may set its own, within these ranges).
# Build rounds the developer may use (1 to 5), rounds of questions to a person (0 to 4; 0 = never ask), and revisions per pull request (1 to 10).
# FACTORY_DEFAULT_BUILD_ROUNDS=3
# FACTORY_DEFAULT_CLARIFICATION_ROUNDS=3
# FACTORY_DEFAULT_REVISIONS_PER_PULL_REQUEST=3

# Token limits. 0 or empty = no limit. Tokens count as input + output + reasoning + cache writes (not cache reads); see docs/configuration.md.
# The most one run may use (a project can set a lower limits.token_budget, never a higher one), the most all runs together may use in a UTC day
# (a run that would go over waits for the next day), and the same for one repository. Each is 0 or a whole number from 10000.
# FACTORY_MAX_TOKENS_PER_RUN=0
# FACTORY_DAILY_TOKEN_LIMIT=0
# FACTORY_REPO_DAILY_TOKEN_LIMIT=0

# Let a repository bring its own sandbox image (.factory/Dockerfile). OFF by default. Turning it on means anyone who can merge to a
# repository's default branch can run build instructions on this machine's Docker, with internet access, the same trust as running its CI.
# Enable it only for repositories whose default branch you control. See docs/configuration.md.
# FACTORY_ALLOW_REPO_IMAGES=false

# The janitor cleans up after the factory once a day. It removes checkouts of finished runs that nothing has touched for a few days, and
# lists work-in-progress branches (factory/issue-<n>-wip) that are old. It deletes those branches only if you allow it AND the ticket is closed.
# FACTORY_JANITOR=true
# FACTORY_JANITOR_INTERVAL_HOURS=24      (1 to 168)
# FACTORY_JANITOR_CHECKOUT_DAYS=2        (1 to 30)
# FACTORY_JANITOR_WIP_DAYS=30            (1 to 365)
# FACTORY_JANITOR_DELETE_WIP=false
# Repository images (see FACTORY_ALLOW_REPO_IMAGES) older than this many days and unused are removed; they are rebuilt when needed. 0 = never.
# FACTORY_JANITOR_IMAGE_DAYS=60          (0 to 365)

# Where per-run git checkouts live. An absolute host path, created in advance and owned by the
# user below; Docker would otherwise create it as root. The same path is used inside containers.
FACTORY_WORKSPACE_ROOT=/var/tmp/dev-foundry-workspaces
# Host user that owns the workspaces (id -u, id -g); the controller and sandboxes run as this user.
FACTORY_UID=1000
FACTORY_GID=1000
# Group of the Docker socket, so the sandbox launcher can reach it without running as root:
#   stat -c %g /var/run/docker.sock
DOCKER_GID=999

# Absolute path of the repository's agents/ folder: shared agent definitions and OpenCode settings,
# mounted read-only into every sandbox. Leave empty to run sandboxes without them.
FACTORY_GLOBAL_CONFIG=

# What the agent containers may reach on the internet (see egress/README.md). After changing it, run
#   docker compose up -d --force-recreate egress-proxy sandbox-launcher
#   enforce  only the hosts of each profile in the allowlist (the default)
#   audit    every HTTPS host is allowed through the proxy, and each one is logged as "audit"
#   open     no restrictions at all: sandboxes get an ordinary internet-connected network, no proxy, no log
SANDBOX_EGRESS=enforce
# Optional: your own allowlist file instead of egress/profiles.json (a path relative to infra/, or absolute).
# EGRESS_PROFILES=../egress/profiles.json

# First two numbers of the internal networks the sandboxes run on (10.250.1.0/24, 10.250.2.0/24 and
# 10.250.3.0/24 by default). Change them only if they clash with a network you use.
SANDBOX_NET_BASE=10.250

# Shared connection settings for services on the Compose network.
# These are container endpoints, independent of the host port overrides below.
# Compose passes each value only to services that explicitly reference it.
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
# Closed-workflow retention, applied only when the namespace is first created.
TEMPORAL_RETENTION=7d
TEMPORAL_TASK_QUEUE=factory-events
SMTP_HOST=mailpit
SMTP_PORT=1025

# Optional host port overrides. Services inside Docker use their standard ports.
POSTGRES_PORT=5432
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222
PGADMIN_PORT=5050
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
CONTROLLER_API_PORT=8000
