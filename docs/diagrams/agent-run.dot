digraph agent_run {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, bgcolor=white, pad=0.3, nodesep=0.35, ranksep=0.5, labelloc=t, labeljust=l, compound=true];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", margin="0.15,0.08", fillcolor="#eef2f6", color="#5b6773"];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#4a5568", arrowsize=0.8];
  label="One agent run: the agent advises, the factory decides";

  wf   [label="Workflow code (in the controller)\nchooses the role, the image, the network profile\nand builds the prompt: ticket text is data between markers", shape=box, style="filled", fillcolor="#eef2f6", color="#5b6773"];
  act  [label="activity  sandbox_run\nimage alias · workspace name · command · timeout\nnetwork profile · role · needs model access", shape=box, style="filled", fillcolor="#eef2f6", color="#5b6773"];
  pol  [label="sandbox-launcher validates the request\nknown image alias · workspace exists and is not a symlink\nenv names · timeout cap · profile exists", shape=hexagon, style="filled", fillcolor="#e8f1e4", color="#2f855a"];
  rej  [label="refused, never retried", shape=box, style="rounded,filled", fillcolor="#fde2e2", color="#c53030"];
  box  [label="disposable container  (fixed by the launcher, not by the request)\nnon-root · read-only root · all capabilities dropped · no-new-privileges\nmemory · CPU · process limits · tmpfs /tmp\nmounts: the workspace (read-only or writable) · the agents folder (read-only)\nthe ChatGPT login only for model runs\nnetwork: none, or one internal network with its own proxy", shape=box, style="rounded,filled", fillcolor="#dbe8ff", color="#2b6cb0"];
  run  [label="opencode run --agent <role> --format json\nthe role file sets permissions, model and variant", shape=box, style="rounded,filled", fillcolor="#dbe8ff", color="#2b6cb0"];
  proxy[label="egress-proxy\nonly the hosts of that profile", shape=box, style="filled", fillcolor="#eef2f6", color="#5b6773"];
  out  [label="exit code · stdout (OpenCode events)\ncontainer removed, even on cancel or timeout", shape=box, style="filled", fillcolor="#eef2f6", color="#5b6773"];
  pars [label="controller extracts the final text\nand sums tokens and cost for the record", shape=box, style="filled", fillcolor="#eef2f6", color="#5b6773"];
  val  [label="strict JSON validator for that role\nshape · allowed values · size limits · safe paths", shape=hexagon, style="filled", fillcolor="#e8f1e4", color="#2f855a"];
  retry[label="one retry that quotes the exact error", shape=box, style="filled", fillcolor="#eef2f6", color="#5b6773"];
  stop [label="a person is asked (comment on the ticket)", shape=box, style="rounded,filled", fillcolor="#fde2e2", color="#c53030"];
  next [label="the workflow decides the next step in code\nfrom the verdict value; checks the agent's claims itself\n(files exist, tests fail then pass, ...)", shape=box, style="rounded,filled,bold", fillcolor="#d4edda", color="#2f855a"];

  wf -> act -> pol;
  pol -> rej [style=dashed, label="violation"];
  pol -> box [label="ok"];
  box -> run; run -> proxy [style=dashed, label="HTTPS only"];
  run -> out -> pars -> val;
  val -> next [label="valid"];
  val -> retry [label="invalid", style=dashed]; retry -> wf [label="second attempt", style=dashed];
  retry -> stop [label="still invalid", style=dashed];

  subgraph cluster_legend {
    label="Legend"; style="rounded"; color="#c3cad2"; fontsize=10; rank=sink;
    agl1 [label="agent (a role file in a sandbox)", shape=box, style="rounded,filled", fillcolor="#dbe8ff", color="#2b6cb0", fontsize=9];
    agl2 [label="factory code decides or checks", shape=box, style="filled", fillcolor="#eef2f6", color="#5b6773", fontsize=9];
    agl3 [label="deterministic check the factory runs itself", shape=hexagon, style="filled", fillcolor="#e8f1e4", color="#2f855a", fontsize=9];
    agl4 [label="a person", shape=ellipse, style="filled", fillcolor="#fff3c4", color="#b7791f", fontsize=9];
    agl1 -> agl2 -> agl3 -> agl4 [style=invis];
  }
}
