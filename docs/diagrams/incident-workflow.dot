digraph incident_workflow {
  graph [rankdir=TB, fontname="Inter",  bgcolor="#f6f3ea", pad=0.5, nodesep=0.45, ranksep=0.60, fontcolor="#12183a", fontsize=17, labelloc=t, labeljust=l, compound=true];
  node  [fontname="Inter", fontsize=13, fontcolor="#12183a", penwidth=1.8, shape=box, style="rounded,filled", margin="0.24,0.14", fillcolor="#ffffff", color="#6b7494"];
  edge  [fontname="DejaVu Sans Mono", fontsize=9, fontcolor="#4f5673", penwidth=1.8, arrowhead=normal, color="#4f5673", arrowsize=0.8];
  label="Incident workflow: advice only, people decide, nothing touches production";

  start   [label=<<B>Ticket labelled incident</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(logs and facts are in the ticket)</FONT>>, shape=oval, style="filled", fillcolor="#ffffff", color="#12183a", penwidth=1.4];
  intake  [label=<<B>Intake</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">clone the affected system's repository</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  analyst [label=<<B>incident-analyst</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">severity · impact · timeline</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">what is missing</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  ask1    [label=<<B>asks on the ticket</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(4 rounds at most)</FONT>>, shape=ellipse, style="filled", fillcolor="#ffe6dd", color="#ff5a36"];
  rej     [label=<<B>rejected</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(not an incident here)</FONT>>, shape=box, style="rounded,filled", fillcolor="#fbe3df", color="#a8381b"];
  invest  [label=<<B>investigator</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">likely causes from the code and git history</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(no production access)</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  verify  [label=<<B>verify the evidence</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">cited files and commits must exist;</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">what is not found is dropped, the</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">hypothesis becomes a low-confidence guess</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
  mitig   [label=<<B>mitigator</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">1 to 4 options with steps, risk,</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">how to verify, a recommendation</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  post    [label=<<B>the ticket gets the assessment,</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">the hypotheses and the options</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];

  subgraph cluster_people {
    label="People decide with fixed commands (not a model's reading of free text)"; style="rounded,filled,dashed"; color="#ff5a36"; fillcolor="#fff1ea"; fontsize=11;
    wait    [label=<<B>waits for a comment</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(7 days at most)</FONT>>, shape=ellipse, style="filled", fillcolor="#ffe6dd", color="#ff5a36"];
    opt     [label=<<B>/option N</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">checklist of unchecked boxes</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">for a person to carry out</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
    hotfix  [label=<<B>/hotfix</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">opens ONE bug ticket with the</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">suspected cause</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
    more    [label=<<B>any other comment</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">= new information</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
    resolved[label=<<B>/resolved</B>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  }
  bug     [label=<<B>BugWorkflow</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(failing test first, then the fix)</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  writer  [label=<<B>postmortem-writer</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">writes ONE new file from the ticket record:</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">docs/postmortems/&lt;date&gt;-incident-&lt;n&gt;.md</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  onefile [label=<<B>exactly that one file?</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">else sent back once</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
  pm      [label=<<B>Draft postmortem pull request</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">a person verifies the facts</FONT>>, shape=box, style="rounded,filled,bold", fillcolor="#c4ebd5", color="#1f8f63"];
  closed  [label=<<B>ticket closed or no reply</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">the run ends</FONT>>, shape=box, style="rounded,filled", fillcolor="#fbe3df", color="#a8381b"];

  start -> intake -> analyst;
  analyst -> ask1 [label="needs\nclarification"]; ask1 -> analyst;
  analyst -> rej [style=dashed, label="reject"];
  analyst -> invest [label="pass"];
  invest -> verify -> mitig -> post -> wait;
  wait -> opt; wait -> hotfix; wait -> more; wait -> resolved; wait -> closed [style=dashed];
  opt -> wait [style=dotted, constraint=false]; hotfix -> wait [style=dotted, constraint=false];
  hotfix -> bug [label="starts via\nthe webhook", style=dashed];
  more -> invest [label="look again\n(3 times at most)", style=dashed, constraint=false];
  resolved -> writer -> onefile -> pm;

  subgraph cluster_legend {
    label="Legend"; style="rounded,dashed"; color="#b9b29c"; fontsize=10; rank=sink;
    inl1 [label=<<B>agent (a role file in a sandbox)</B>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca", fontsize=9];
    inl2 [label=<<B>factory code decides or checks</B>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494", fontsize=9];
    inl3 [label=<<B>deterministic check the factory runs itself</B>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63", fontsize=9];
    inl4 [label=<<B>a person</B>>, shape=ellipse, style="filled", fillcolor="#ffe6dd", color="#ff5a36", fontsize=9];
    inl1 -> inl2 -> inl3 -> inl4 [style=invis];
  }
}
