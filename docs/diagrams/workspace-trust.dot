digraph workspace_trust {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, bgcolor=white, pad=0.3, nodesep=0.35, ranksep=0.5, labelloc=t, labeljust=l, compound=true];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", margin="0.15,0.08", fillcolor="#eef2f6", color="#5b6773"];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#4a5568", arrowsize=0.8];
  label="Two copies of the checkout: git never runs where the agent can write";

  forgejo [label="Forgejo repository", shape=box, style="rounded,filled", fillcolor="#e1f0e3", color="#2f855a"];
  base    [label=".base/<ticket>  pristine clone\nonly the controller touches it\ngit runs ONLY here (hooks disabled)", shape=folder, style="filled", fillcolor="#fdf2c8", color="#b7791f"];
  work    [label="<ticket>  the copy the agent works in\nmounted into the sandbox\ngit NEVER runs here (it could hold hostile hooks)", shape=folder, style="filled", fillcolor="#ffe3c7", color="#c05621"];
  sandbox [label="sandbox\nagent edits files, runs the project's checks", shape=box, style="rounded,filled", fillcolor="#dbe8ff", color="#2b6cb0"];
  inspect [label="inspect the agent's tree as plain files\n(through git's trusted directory)\nprotected paths · symlinks · size · secrets", shape=hexagon, style="filled", fillcolor="#e8f1e4", color="#2f855a"];
  apply   [label="copy ONLY verified regular files\nonto the pristine clone", shape=box, style="filled", fillcolor="#eef2f6", color="#5b6773"];
  commit  [label="commit · push factory/issue-N\nopen the pull request", shape=box, style="filled", fillcolor="#eef2f6", color="#5b6773"];
  rec     [label=".records/<ticket>\nprompts · answers · check output · tokens\n(redacted for secrets)", shape=folder, style="filled", fillcolor="#fdf2c8", color="#b7791f"];
  runs    [label=".factory/runs/issue-N-<run>/\non the branch, if the project sets\n\"record\": true", shape=box, style="rounded,filled,bold", fillcolor="#d4edda", color="#2f855a"];

  forgejo -> base [label="git clone (bot token)"];
  base -> work [label="cp -a"];
  work -> sandbox [dir=both, label="mounted"];
  work -> inspect [label="read"];
  inspect -> apply [label="all clear"];
  base -> apply [style=invis];
  apply -> base [label="write", constraint=false];
  base -> commit;
  sandbox -> rec [style=invis];
  rec -> runs [label="added at publish"];
  runs -> commit [style=dotted];

  subgraph cluster_legend {
    label="Legend"; style="rounded"; color="#c3cad2"; fontsize=10; rank=sink;
    wol1 [label="agent (a role file in a sandbox)", shape=box, style="rounded,filled", fillcolor="#dbe8ff", color="#2b6cb0", fontsize=9];
    wol2 [label="factory code decides or checks", shape=box, style="filled", fillcolor="#eef2f6", color="#5b6773", fontsize=9];
    wol3 [label="deterministic check the factory runs itself", shape=hexagon, style="filled", fillcolor="#e8f1e4", color="#2f855a", fontsize=9];
    wol4 [label="a person", shape=ellipse, style="filled", fillcolor="#fff3c4", color="#b7791f", fontsize=9];
    wol1 -> wol2 -> wol3 -> wol4 [style=invis];
  }
}
