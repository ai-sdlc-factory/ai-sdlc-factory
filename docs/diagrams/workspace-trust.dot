digraph workspace_trust {
  graph [rankdir=TB, fontname="Inter",  bgcolor="#f6f3ea", pad=0.5, nodesep=0.45, ranksep=0.60, fontcolor="#12183a", fontsize=17, labelloc=t, labeljust=l, compound=true];
  node  [fontname="Inter", fontsize=13, fontcolor="#12183a", penwidth=1.8, shape=box, style="rounded,filled", margin="0.24,0.14", fillcolor="#ffffff", color="#6b7494"];
  edge  [fontname="DejaVu Sans Mono", fontsize=9, fontcolor="#4f5673", penwidth=1.8, arrowhead=normal, color="#4f5673", arrowsize=0.8];
  label="Two copies of the checkout: git never runs where the agent can write";

  host [label=<<B>Git host repository</B>>, shape=box, style="rounded,filled", fillcolor="#dff3e9", color="#1f8f63"];
  base    [label=<<B>.base/&lt;ticket&gt;  pristine clone</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">only the controller touches it</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">git runs ONLY here (hooks disabled)</FONT>>, shape=folder, style="filled", fillcolor="#efeadd", color="#8b8570"];
  work    [label=<<B>&lt;ticket&gt;  the copy the agent works in</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">mounted into the sandbox</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">git NEVER runs here (it could hold hostile hooks)</FONT>>, shape=folder, style="filled", fillcolor="#fff0e0", color="#d9622b"];
  sandbox [label=<<B>sandbox</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">agent edits files, runs the project's checks</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  inspect [label=<<B>inspect the agent's tree as plain files</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(through git's trusted directory)</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">protected paths · symlinks · size · secrets</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
  apply   [label=<<B>copy ONLY verified regular files</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">onto the pristine clone</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  commit  [label=<<B>commit · push factory/issue-N</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">open the pull request</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  rec     [label=<<B>.records/&lt;ticket&gt;</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">prompts · answers · check output · tokens</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(redacted for secrets)</FONT>>, shape=folder, style="filled", fillcolor="#efeadd", color="#8b8570"];
  runs    [label=<<B>.factory/runs/issue-N-&lt;run&gt;/</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">on the branch, if the project sets</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">\"record\": true</FONT>>, shape=box, style="rounded,filled,bold", fillcolor="#c4ebd5", color="#1f8f63"];

  host -> base [label="git clone (bot token)"];
  base -> work [label="cp -a"];
  work -> sandbox [dir=both, label="mounted"];
  work -> inspect [label="read"];
  inspect -> apply [label="all clear"];
  base -> apply [style=invis];
  apply -> base [label="write", constraint=false];
  base -> commit;
  sandbox -> rec [style=invis];
  rec -> runs [label="added at publish"];
  runs -> commit [style=dotted];

  subgraph cluster_legend {
    label="Legend"; style="rounded,dashed"; color="#b9b29c"; fontsize=10; rank=sink;
    wol1 [label=<<B>agent (a role file in a sandbox)</B>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca", fontsize=9];
    wol2 [label=<<B>factory code decides or checks</B>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494", fontsize=9];
    wol3 [label=<<B>deterministic check the factory runs itself</B>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63", fontsize=9];
    wol4 [label=<<B>a person</B>>, shape=ellipse, style="filled", fillcolor="#ffe6dd", color="#ff5a36", fontsize=9];
    wol1 -> wol2 -> wol3 -> wol4 [style=invis];
  }
}
