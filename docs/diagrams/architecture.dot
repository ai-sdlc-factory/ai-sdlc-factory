// The whole solution: who talks to whom, and where the trust boundaries are.
digraph architecture {
  graph [rankdir=TB, fontname="Inter",  bgcolor="#f6f3ea", pad=0.5, nodesep=0.48, ranksep=0.80, fontcolor="#12183a", fontsize=17,
         label="AI SDLC Factory: system overview", labelloc=t, labeljust=l];
  node  [fontname="Inter", fontsize=13, fontcolor="#12183a", penwidth=1.8, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494", margin="0.24,0.14"];
  edge  [fontname="DejaVu Sans Mono", fontsize=9, fontcolor="#4f5673", penwidth=1.8, arrowhead=normal, color="#4f5673", arrowsize=0.8];

  person  [label=<<B>You</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">create tickets, answer questions,</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">review and merge pull requests</FONT>>, shape=ellipse, fillcolor="#ffe6dd", color="#ff5a36"];
  model   [label=<<B>Model provider</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">chatgpt.com · auth.openai.com</FONT>>, shape=box, style="rounded,filled,dashed", fillcolor="#f6f3ea", color="#8b8570"];
  registry[label=<<B>Package registries</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">PyPI · npm · NuGet · ...</FONT>>, shape=box, style="rounded,filled,dashed", fillcolor="#f6f3ea", color="#8b8570"];

  subgraph cluster_stack {
    label="Docker Compose stack on your machine"; style="rounded,dashed"; color="#b9b29c"; fontsize=11;

    host [label=<<B>Git host</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(Forgejo or GitHub)</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">tickets · repositories · PRs</FONT>>, fillcolor="#dff3e9", color="#1f8f63"];

    subgraph cluster_control {
      label="control plane (no model, no Docker)"; style="rounded,dashed"; color="#b9b29c"; fillcolor="#efeadd"; style="rounded,filled,dashed";
      api        [label=<<B>api</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">checks the webhook signature,</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">starts a workflow</FONT>>];
      temporal   [label=<<B>Temporal</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">stores every workflow's history</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(7 days by default)</FONT>>, fillcolor="#e6e9fb", color="#3b4cca"];
      controller [label=<<B>controller</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">the workflows and all decisions</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">holds the git host tokens</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">runs git on the pristine clone</FONT>>, fillcolor="#e6e9fb", color="#3b4cca"];
    }

    temporaldb [label=<<B>Temporal data</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">SQLite file (default)</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">or PostgreSQL (optional)</FONT>>, shape=cylinder, fillcolor="#ffffff"];

    subgraph cluster_sandboxing {
      label="agent sandboxing (the only place with Docker access)"; style="rounded,filled,dashed"; color="#d9622b"; fillcolor="#fff7ee";
      launcher [label=<<B>sandbox-launcher</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">the only service with the Docker socket</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">fixed isolation policy, max 2 at once</FONT>>, fillcolor="#fff0e0", color="#d9622b"];
      sandbox  [label=<<B>disposable sandbox  (one per agent run)</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">OpenCode + one role file + the project's image</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">non-root · read-only root · no capabilities</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">no route out except the proxy</FONT>>, fillcolor="#fff0e0", color="#d9622b"];
      proxy    [label=<<B>egress-proxy</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">HTTPS tunnels to allowlisted hosts only</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">logs every decision</FONT>>, fillcolor="#fff0e0", color="#d9622b"];
    }

    workspaces [label=<<B>workspace folder on the host</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">.base/&lt;ticket&gt;  pristine clone</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">&lt;ticket&gt;  copy the agent works in</FONT>>, shape=folder, fillcolor="#efeadd", color="#8b8570"];
    login      [label=<<B>opencode-data volume</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">the ChatGPT login</FONT>>, shape=cylinder, fillcolor="#efeadd", color="#8b8570"];
    agents     [label=<<B>agents/ folder</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">role files, read-only</FONT>>, shape=folder, fillcolor="#efeadd", color="#8b8570"];
  }

  person -> host [label="tickets, comments,\nPR reviews"];
  host -> api [label="signed webhook\n(issues, comments)"];
  api -> temporal [label="start\nRepoEventWorkflow"];
  temporal -> controller [label="task queue\nfactory-events", dir=both];
  controller -> host [label="comments, branches,\npull requests (bot token)"];
  controller -> workspaces [label="clone · copy · inspect\ncommit · push"];
  controller -> temporal [label="sandbox_run activity\nqueue: sandbox", style=dashed];
  temporal -> launcher [style=dashed];
  launcher -> sandbox [label="docker create/start/remove"];
  sandbox -> workspaces [label="mounts the copy\n(read-only or writable)", dir=back];
  sandbox -> login [label="login mounted only\nfor model runs", style=dashed];
  sandbox -> agents [label="/etc/factory", style=dashed];
  sandbox -> proxy [label="HTTPS_PROXY"];
  proxy -> model;
  proxy -> registry [label="packages /\ndeveloper profile"];
  temporal -> temporaldb [style=dotted, arrowhead=none];
  controller -> agents [style=dotted, label="model names only"];
}
