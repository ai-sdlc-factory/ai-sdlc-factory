digraph ticket_routing {
  graph [rankdir=TB, fontname="Inter",  bgcolor="#f6f3ea", pad=0.5, nodesep=0.28, ranksep=0.60, fontcolor="#12183a", fontsize=17, labelloc=t, labeljust=l, compound=true];
  node  [fontname="Inter", fontsize=13, fontcolor="#12183a", penwidth=1.8, shape=box, style="rounded,filled", margin="0.24,0.14", fillcolor="#ffffff", color="#6b7494"];
  edge  [fontname="DejaVu Sans Mono", fontsize=9, fontcolor="#4f5673", penwidth=1.8, arrowhead=normal, color="#4f5673", arrowsize=0.8];
  label="From a git host event to a workflow";

  host [label=<<B>Git host</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">issue opened · reopened · labelled · closed</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">comment created</FONT>>, shape=box, style="rounded,filled", fillcolor="#dff3e9", color="#1f8f63"];
  api     [label=<<B>api</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">verifies the HMAC signature</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">rejects repeats of the same delivery id</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  router  [label=<<B>RepoEventWorkflow  (the router)</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">stored in Temporal, decides with fixed rules</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  kind    [label=<<B>which label?</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">incident  &gt;  plan  &gt;  feature  &gt;  bug  &gt;  docs</FONT>>, shape=diamond, style="filled", fillcolor="#ffffff", color="#6b7494", margin="0.05,0.05"];
  fw [label=<<B>FeatureWorkflow</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">id  feature-&lt;repo&gt;-&lt;n&gt;-&lt;hash&gt;</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  bw [label=<<B>BugWorkflow</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">id  bug-&lt;repo&gt;-&lt;n&gt;-&lt;hash&gt;</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  dw [label=<<B>DocsWorkflow</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">id  docs-&lt;repo&gt;-&lt;n&gt;-&lt;hash&gt;</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  iw [label=<<B>IncidentWorkflow</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">id  incident-&lt;repo&gt;-&lt;n&gt;-&lt;hash&gt;</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  comment [label=<<B>comment on a ticket</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">signal human_reply to the</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">running workflow</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  none    [label=<<B>no running workflow</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(finished or never started)</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">one notice, by the state of its pull request</FONT>>, shape=box, style="rounded,filled", fillcolor="#fbe3df", color="#a8381b"];
  closed  [label=<<B>ticket closed</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">signal ticket_closed</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(the run stops)</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  rev     [label=<<B>PullRequestRevisionWorkflow</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">id  revision-&lt;repo&gt;-&lt;pr&gt;-&lt;hash&gt;</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  prev    [label=<<B>a review that requests changes, or</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">/fix in a comment, on a pull</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">request (the factory checks</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">it is its own)</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  qa      [label=<<B>QaWorkflow</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">id  qa-&lt;repo&gt;-&lt;n&gt;-&lt;hash&gt;</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  qacmd   [label=<<B>/qa  /qa full  /qa api|ui  /qa &lt;note&gt;</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">on a feature or bug ticket,</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">or on the factory's pull request</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  upd     [label=<<B>PullRequestUpdateWorkflow</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">id  update-&lt;repo&gt;-&lt;n&gt;-&lt;hash&gt;</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  updcmd  [label=<<B>/update on a feature or bug ticket,</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">or on the factory's pull request</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">merges the base branch into it</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  rvw     [label=<<B>PullRequestReviewWorkflow</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">id  review-&lt;repo&gt;-&lt;pr&gt;-&lt;hash&gt;</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  rvwcmd  [label=<<B>/review on any pull request</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">reviewers post findings, read only</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  retry   [label=<<B>/retry on an open ticket</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">starts the run again,</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">like reopening (a notice if one</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">is still running)</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  ignored [label=<<B>ignored</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">other pull request events</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">factory's own comments</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">tickets with none of the factory labels</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  reopen  [label=<<B>reopened</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">starts a new run</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(label changes alone do nothing)</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  host -> api [label="signed webhook"];
  api -> router [label="Temporal workflow"];
  router -> kind [label="opened / labelled"];
  router -> reopen [style=dashed];
  reopen -> kind;
  kind -> iw; kind -> fw; kind -> bw; kind -> dw;
  router -> comment; router -> closed; router -> ignored; router -> prev; router -> qacmd; router -> updcmd; router -> rvwcmd; router -> retry;
  prev -> rev;
  qacmd -> qa;
  updcmd -> upd;
  rvwcmd -> rvw;
  retry -> kind [style=dashed];
  // layout only: spread the router's branches over rows so the picture stays narrow
  retry -> prev [style=invis]; comment -> qacmd [style=invis]; closed -> updcmd [style=invis]; ignored -> rvwcmd [style=invis];
  fw -> dw [style=invis]; bw -> iw [style=invis];
  comment -> none [label="nobody listening", style=dashed];
  comment -> fw [style=dotted]; comment -> bw [style=dotted]; comment -> iw [style=dotted];

  rvw -> til1 [style=invis];
  subgraph cluster_legend {
    label="Legend"; style="rounded,dashed"; color="#b9b29c"; fontsize=10; 
    til1 [label=<<B>agent (a role file in a sandbox)</B>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca", fontsize=9];
    til2 [label=<<B>factory code decides or checks</B>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494", fontsize=9];
    til3 [label=<<B>deterministic check the factory runs itself</B>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63", fontsize=9];
    til4 [label=<<B>a person</B>>, shape=ellipse, style="filled", fillcolor="#ffe6dd", color="#ff5a36", fontsize=9];
        til1 -> til2 -> til3 -> til4 [style=invis];
  }
}
