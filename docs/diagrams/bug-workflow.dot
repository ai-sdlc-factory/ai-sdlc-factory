digraph bug_workflow {
  graph [rankdir=TB, fontname="Inter",  bgcolor="#f6f3ea", pad=0.5, nodesep=0.45, ranksep=0.60, fontcolor="#12183a", fontsize=17, labelloc=t, labeljust=l, compound=true];
  node  [fontname="Inter", fontsize=13, fontcolor="#12183a", penwidth=1.8, shape=box, style="rounded,filled", margin="0.24,0.14", fillcolor="#ffffff", color="#6b7494"];
  edge  [fontname="DejaVu Sans Mono", fontsize=9, fontcolor="#4f5673", penwidth=1.8, arrowhead=normal, color="#4f5673", arrowsize=0.8];
  label="Bug workflow: a fix proven by a test that fails before and passes after";

  start   [label=<<B>Ticket labelled bug</B>>, shape=oval, style="filled", fillcolor="#ffffff", color="#12183a", penwidth=1.4];
  intake  [label=<<B>Intake</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">clone · copy · read .factory/project.json</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  banalyst[label=<<B>bug-analyst</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">expected vs actual · severity</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  ask1    [label=<<B>asks on the ticket</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(4 rounds at most)</FONT>>, shape=ellipse, style="filled", fillcolor="#ffe6dd", color="#ff5a36"];
  rej     [label=<<B>rejected</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(not a bug)</FONT>>, shape=box, style="rounded,filled", fillcolor="#fbe3df", color="#a8381b"];
  repro   [label=<<B>reproducer</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">writes ONE failing test</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(test files only)</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  files   [label=<<B>only the listed test files changed?</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">no deletions · protected paths · secrets</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
  red     [label=<<B>RED check</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">the factory runs the test command</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">on the unchanged code: it must FAIL</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
  cannot  [label=<<B>cannot_reproduce</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(3 attempts used)</FONT>>, shape=box, style="rounded,filled", fillcolor="#fbe3df", color="#a8381b"];
  quick   [label=<<B>quick mode?</B>>, shape=diamond, style="filled", fillcolor="#ffffff", color="#6b7494", margin="0.05,0.05"];
  diag    [label=<<B>diagnostician</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">root cause · where to fix</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  large   [label=<<B>needs_design</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(too large: open a feature ticket)</FONT>>, shape=box, style="rounded,filled", fillcolor="#fbe3df", color="#a8381b"];

  subgraph cluster_build {
    label="Build loop  (3 rounds at most)"; style="rounded,filled,dashed"; color="#b9b29c"; fillcolor="#efeadd"; fontsize=11;
    developer[label=<<B>developer</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">fixes the code</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">may not edit the test</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
    tamper   [label=<<B>reproduction test unchanged?</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(SHA-256 of its files)</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
    gates    [label=<<B>change checks + project checks</B>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
    green    [label=<<B>GREEN check</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">the same test command must now PASS</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
    reviewers[label=<<B>reviewers</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(no acceptance check:</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">red then green is the proof)</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
    ok       [label=<<B>everything passes?</B>>, shape=diamond, style="filled", fillcolor="#ffffff", color="#6b7494", margin="0.05,0.05"];
  }
  publish [label=<<B>Publish</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">commit · push · open the pull request  Fix: &lt;title&gt;</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  pr      [label=<<B>Pull request</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">with severity, root cause and the proof</FONT>>, shape=box, style="rounded,filled,bold", fillcolor="#c4ebd5", color="#1f8f63"];
  wip     [label=<<B>Work-in-progress branch</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">+ a comment on the ticket</FONT>>, shape=box, style="rounded,filled", fillcolor="#fbe3df", color="#a8381b"];

  start -> intake -> banalyst;
  banalyst -> ask1 [label="needs\nclarification"]; ask1 -> banalyst;
  banalyst -> rej [style=dashed, label="reject"];
  banalyst -> repro [label="pass"];
  repro -> files -> red;
  red -> repro [label="passes or can't run:\nsent back with the reason", style=dashed, color="#ff5a36", fontcolor="#ff5a36"];
  red -> cannot [label="3 attempts", style=dashed];
  red -> quick [label="fails as required"];
  quick -> diag [label="no"];
  quick -> developer [label="yes: skip the diagnosis", style=dashed];
  diag -> large [label="too_large", style=dashed];
  diag -> developer [label="pass"];
  developer -> tamper -> gates -> green -> reviewers -> ok;
  ok -> publish [label="yes"];
  ok -> developer [label="no: feedback", constraint=false, style=dashed, color="#ff5a36", fontcolor="#ff5a36"];
  publish -> pr;
  ok -> wip [label="out of rounds", style=dashed];

  subgraph cluster_legend {
    label="Legend"; style="rounded,dashed"; color="#b9b29c"; fontsize=10; rank=sink;
    bul1 [label=<<B>agent (a role file in a sandbox)</B>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca", fontsize=9];
    bul2 [label=<<B>factory code decides or checks</B>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494", fontsize=9];
    bul3 [label=<<B>deterministic check the factory runs itself</B>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63", fontsize=9];
    bul4 [label=<<B>a person</B>>, shape=ellipse, style="filled", fillcolor="#ffe6dd", color="#ff5a36", fontsize=9];
    bul1 -> bul2 -> bul3 -> bul4 [style=invis];
  }
}
