digraph monitoring {
  graph [rankdir=LR, fontname="Inter",  bgcolor="#f6f3ea", pad=0.5, nodesep=0.50, ranksep=0.70, fontcolor="#12183a", fontsize=17, labelloc=t, labeljust=l, compound=true];
  node  [fontname="Inter", fontsize=13, fontcolor="#12183a", penwidth=1.8, shape=box, style="rounded,filled", margin="0.24,0.14", fillcolor="#ffffff", color="#6b7494"];
  edge  [fontname="DejaVu Sans Mono", fontsize=9, fontcolor="#4f5673", penwidth=1.8, arrowhead=normal, color="#4f5673", arrowsize=0.8];
  label="From an alert to a ticket the factory can act on";

  subgraph cluster_app {
    label="The application (delivered from the default branch)"; style="rounded,filled,dashed"; color="#b9b29c"; fillcolor="#efeadd"; fontsize=11;
    deploy [label=<<B>deploy.sh</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">build · switch over</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">check · roll back</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
    api    [label=<<B>shop-api</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(Python, SQLite)</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
    web    [label=<<B>shop-web</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(nginx)</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  }

  subgraph cluster_watch {
    label="Watching it"; style="rounded,filled,dashed"; color="#b9b29c"; fillcolor="#efeadd"; fontsize=11;
    blackbox [label=<<B>blackbox probes</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">does it answer, how fast?</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
    cadvisor [label=<<B>container-stats</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">state · restarts · memory · CPU</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
    promtail [label=<<B>Promtail → Loki</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">the containers' logs</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
    prom     [label=<<B>Prometheus</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">metrics and alert rules</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
    grafana  [label=<<B>Grafana</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">dashboard · delivery markers</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  }

  am     [label=<<B>Alertmanager</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">groups alerts, repeats every 12 h</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  intake [label=<<B>alert-intake  (fixed rules, no AI)</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">route table · dedup by fingerprint · rate limit</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">redacted, bounded evidence · dry run by default</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  host[label=<<B>Ticket on a git host</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">label: incident</FONT>>, shape=box, style="rounded,filled,bold", fillcolor="#c4ebd5", color="#1f8f63"];
  inc    [label=<<B>Incident workflow</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">assessment · causes · options</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(advice only)</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
  person [label=<<B>A person decides</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">/option · /hotfix · /resolved</FONT>>, shape=ellipse, style="filled", fillcolor="#ffe6dd", color="#ff5a36"];

  deploy -> api; deploy -> web;
  blackbox -> api [label="GET /api/products", style=dashed]; blackbox -> web [label="/healthz", style=dashed];
  cadvisor -> api [style=dashed]; promtail -> api [style=dashed];
  blackbox -> prom; cadvisor -> prom; promtail -> prom [label="Loki rules", constraint=false];
  prom -> grafana; deploy -> grafana [label="marker", style=dotted];
  prom -> am [label="alert"]; promtail -> am [label="log alert", style=dashed];
  am -> intake [label="webhook + token"];
  intake -> host [label="opens one ticket\ncomments when resolved"];
  intake -> promtail [label="recent log lines", style=dotted, constraint=false];
  host -> inc [label="webhook"];
  inc -> person;

  subgraph cluster_legend {
    label="Legend"; style="rounded,dashed"; color="#b9b29c"; fontsize=10; rank=sink;
    til1 [label=<<B>agent (a role file in a sandbox)</B>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca", fontsize=9];
    til2 [label=<<B>code decides or checks</B>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494", fontsize=9];
    til3 [label=<<B>measurement taken by tooling</B>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63", fontsize=9];
    til4 [label=<<B>a person</B>>, shape=ellipse, style="filled", fillcolor="#ffe6dd", color="#ff5a36", fontsize=9];
    til1 -> til2 -> til3 -> til4 [style=invis];
  }
}
