digraph pr_revision {
  graph [rankdir=TB, fontname="Inter",  bgcolor="#f6f3ea", pad=0.5, nodesep=0.45, ranksep=0.60, fontcolor="#12183a", fontsize=17, labelloc=t, labeljust=l, compound=true];
  node  [fontname="Inter", fontsize=13, fontcolor="#12183a", penwidth=1.8, shape=box, style="rounded,filled", margin="0.24,0.14", fillcolor="#ffffff", color="#6b7494"];
  edge  [fontname="DejaVu Sans Mono", fontsize=9, fontcolor="#4f5673", penwidth=1.8, arrowhead=normal, color="#4f5673", arrowsize=0.8];
  label="Pull request revision: a person's review becomes one new commit on the same branch";

  start  [label=<<B>A person requests changes on a pull request</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">the factory opened, or comments /fix</FONT>>, shape=oval, style="filled", fillcolor="#ffffff", color="#12183a", penwidth=1.4];
  read   [label=<<B>Read the pull request and the latest review</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">from the git host: its comments, line by line</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  rules  [label=<<B>Is it the factory's own pull request?</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">open · same repository · fewer than 3 revisions</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">something to act on?</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
  refuse [label=<<B>a short note (not the factory's · closed · limit reached · nothing to do)</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">or nothing at all for a review on someone else's pull request</FONT>>, shape=box, style="rounded,filled", fillcolor="#fbe3df", color="#a8381b"];
  intake [label=<<B>Check out the pull request's own branch</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">read .factory/project.json</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];

  subgraph cluster_loop {
    label="Revision loop  (3 rounds at most)"; style="rounded,filled,dashed"; color="#b9b29c"; fillcolor="#efeadd"; fontsize=11;
    resolver [label=<<B>pr-resolver</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">for each numbered comment: fixed, answered,</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">declined (with a reason) or needs clarification</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
    answers  [label=<<B>every comment answered exactly once?</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">\"fixed\" must mean files really changed</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
    checks   [label=<<B>change checks + the project's checks</B>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
    reviewers[label=<<B>reviewers look at the revision</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(acceptance check only for larger revisions)</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
    ok       [label=<<B>everything passes?</B>>, shape=diamond, style="filled", fillcolor="#ffffff", color="#6b7494", margin="0.05,0.05"];
  }
  replied [label=<<B>Reply on the pull request: nothing was pushed,</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">with the answer to each comment</FONT>>, shape=box, style="rounded,filled,bold", fillcolor="#c4ebd5", color="#1f8f63"];
  push    [label=<<B>Push ONE new commit onto the same branch</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">never forced; refused if someone pushed meanwhile</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  reply   [label=<<B>Reply on the pull request: the commit,</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">a table of what was done per comment, the checks</FONT>>, shape=box, style="rounded,filled,bold", fillcolor="#c4ebd5", color="#1f8f63"];
  again   [label=<<B>A person reviews again and merges</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(the factory never merges)</FONT>>, shape=ellipse, style="filled", fillcolor="#ffe6dd", color="#ff5a36"];
  wip     [label=<<B>Nothing pushed to the pull request</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">work saved on a -wip branch + a comment</FONT>>, shape=box, style="rounded,filled", fillcolor="#fbe3df", color="#a8381b"];

  start -> read -> rules;
  rules -> refuse [label="no", style=dashed];
  rules -> intake [label="yes"];
  intake -> resolver -> answers;
  answers -> resolver [label="no: sent back with the reason", style=dashed, color="#ff5a36", fontcolor="#ff5a36", constraint=false];
  answers -> replied [label="no file changed:\nall answered or declined"];
  answers -> checks [label="files changed"];
  checks -> reviewers -> ok;
  ok -> push [label="yes"];
  ok -> resolver [label="no: feedback", style=dashed, color="#ff5a36", fontcolor="#ff5a36", constraint=false];
  ok -> wip [label="out of rounds\nor blocked", style=dashed];
  push -> reply -> again;
}
