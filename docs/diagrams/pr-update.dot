digraph pr_update {
  graph [rankdir=TB, fontname="Inter",  bgcolor="#f6f3ea", pad=0.5, nodesep=0.45, ranksep=0.60, fontcolor="#12183a", fontsize=17, labelloc=t, labeljust=l, compound=true];
  node  [fontname="Inter", fontsize=13, fontcolor="#12183a", penwidth=1.8, shape=box, style="rounded,filled", margin="0.24,0.14", fillcolor="#ffffff", color="#6b7494"];
  edge  [fontname="DejaVu Sans Mono", fontsize=9, fontcolor="#4f5673", penwidth=1.8, arrowhead=normal, color="#4f5673", arrowsize=0.8];
  label="Pull request update: the base branch is merged into the pull request's branch, as one merge commit";

  start  [label=<<B>A person comments /update on the ticket</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">or on the factory's pull request</FONT>>, shape=oval, style="filled", fillcolor="#ffffff", color="#12183a", penwidth=1.4];
  rules  [label=<<B>Is it the factory's own open pull request?</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(on a ticket: find its pull request)</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
  refuse [label=<<B>a short note: not the factory's · no pull request · closed</B>>, shape=box, style="rounded,filled", fillcolor="#fbe3df", color="#a8381b"];
  merge  [label=<<B>The controller merges the base branch</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">into the pull request's branch in its own clone</FONT><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(git never runs in an agent's copy)</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  state  [label=<<B>what did the merge do?</B>>, shape=diamond, style="filled", fillcolor="#ffffff", color="#6b7494", margin="0.05,0.05"];
  uptodate [label=<<B>Nothing to merge: the branch already</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">has everything from the base</FONT>>, shape=box, style="rounded,filled,bold", fillcolor="#c4ebd5", color="#1f8f63"];
  giveup [label=<<B>A person merges by hand: protected file in conflict,</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">more than 40 files, or a merge git cannot make</FONT>>, shape=box, style="rounded,filled", fillcolor="#fbe3df", color="#a8381b"];

  subgraph cluster_loop {
    label="Resolve and check  (3 rounds at most)"; style="rounded,filled,dashed"; color="#b9b29c"; fillcolor="#efeadd"; fontsize=11;
    resolver [label=<<B>merge-resolver, on a copy of the merged files</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">one answer per conflicted file; fixes what the merge broke</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
    markers  [label=<<B>every conflict answered once?</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">no conflict marker left? only allowed files changed?</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
    checks   [label=<<B>change checks + the project's checks</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">on the merged tree</FONT>>, shape=hexagon, style="filled", fillcolor="#dff3e9", color="#1f8f63"];
    reviewers[label=<<B>reviewers look at what the agent wrote</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(a merge git made alone needs none)</FONT>>, shape=box, style="rounded,filled", fillcolor="#e6e9fb", color="#3b4cca"];
    ok       [label=<<B>everything passes?</B>>, shape=diamond, style="filled", fillcolor="#ffffff", color="#6b7494", margin="0.05,0.05"];
  }
  push   [label=<<B>Push ONE merge commit with two parents</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">never forced; refused if someone pushed meanwhile</FONT>>, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7494"];
  reply  [label=<<B>Reply: the merge commit, files that came in,</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">how each conflict was resolved, the checks</FONT>>, shape=box, style="rounded,filled,bold", fillcolor="#c4ebd5", color="#1f8f63"];
  again  [label=<<B>A person reviews and merges</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">(the factory never merges)</FONT>>, shape=ellipse, style="filled", fillcolor="#ffe6dd", color="#ff5a36"];
  wip    [label=<<B>Nothing pushed to the pull request</B><BR/><FONT COLOR="#4f5673" POINT-SIZE="11">work saved on a -wip branch + a comment</FONT>>, shape=box, style="rounded,filled", fillcolor="#fbe3df", color="#a8381b"];

  start -> rules;
  rules -> refuse [label="no", style=dashed];
  rules -> merge [label="yes"];
  merge -> state;
  state -> uptodate [label="already has the base"];
  state -> giveup [label="cannot be done\nby the factory", style=dashed];
  state -> resolver [label="conflicts"];
  state -> checks [label="clean merge:\nno agent needed"];
  resolver -> markers;
  markers -> resolver [label="no: sent back with the reason", style=dashed, color="#ff5a36", fontcolor="#ff5a36", constraint=false];
  markers -> checks [label="yes"];
  checks -> reviewers [label="passed, agent wrote files"];
  checks -> push [label="passed, clean merge"];
  checks -> resolver [label="failed: output goes back", style=dashed, color="#ff5a36", fontcolor="#ff5a36", constraint=false];
  reviewers -> ok;
  ok -> push [label="yes"];
  ok -> resolver [label="no: feedback", style=dashed, color="#ff5a36", fontcolor="#ff5a36", constraint=false];
  ok -> wip [label="out of rounds\nor blocked", style=dashed];
  push -> reply -> again;
}
